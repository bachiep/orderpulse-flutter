# OrderPulse Flutter — Runtime Dart-Define Configuration Example
# Pass values at run/build time without committing secrets:
#   flutter run --dart-define=APP_ENV=live \
#     --dart-define=API_BASE_URL=http://10.0.2.2:8301 \
#     --dart-define=WS_BASE_URL=ws://10.0.2.2:8301/ws/orders

# Runtime mode: demo (default standalone interactive mode) or live
APP_ENV=demo

# Android Emulator uses 10.0.2.2 to reach host localhost; iOS Simulator/Web/Desktop use localhost
API_BASE_URL=http://10.0.2.2:8301
WS_BASE_URL=ws://10.0.2.2:8301/ws/orders
